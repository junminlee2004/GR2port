#version 460

// FSR 3.1.6's frame generation reads a depth that grows away from the camera, 0 at the near plane
// and 1 at the far one: 1 less the scene's reversed depth, of the same projection.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D scene_depth;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D depth;

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(depth)))) {
        return;
    }
    imageStore(depth, pixel, vec4(1.0 - texelFetch(scene_depth, pixel, 0).r));
}
