#version 460
#extension GL_GOOGLE_include_directive : require

#include "scene.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D scene;

layout(push_constant) uniform Constants {
    Meter meter;
    uvec2 size;
    uvec2 offset;
};

// The game's luminance program: one pixel of each 8x8 tile, at an offset that changes each frame.
// All tiles add to one sum, here with an atomic in fixed point.
void main() {
    const uvec2 tile = gl_GlobalInvocationID.xy * 8u;
    if (any(greaterThanEqual(tile, size))) {
        return;
    }
    const ivec2 pixel = ivec2(min(tile + offset, size - 1u));
    const float luminance = dot(texelFetch(scene, pixel, 0).rgb, vec3(0.299, 0.587, 0.114));
    atomicAdd(meter.log_sum, int(round(log(max(luminance, 1e-6)) * MeterScale)));
}
