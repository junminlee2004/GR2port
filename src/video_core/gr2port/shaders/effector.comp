// The game's effector program (0x1c287b8): each invocation lists the effector spheres of one cell
// of the view, 6 x 6 across it and 10 depth slices deep. A sphere is listed when its view-space
// center is within its outer radius of all six planes of the cell. The workgroup's z is the slice.

#version 460

#extension GL_GOOGLE_include_directive : require

#include "scene.glsl"
#include "soft_body.glsl"

layout(local_size_x = 6, local_size_y = 6) in;

void main() {
    Effectors effector = Effectors(effectors);
    Grid cells = Grid(grid);
    const uvec3 cell = gl_GlobalInvocationID;
    const float x = float(cell.x);
    const float y = float(cell.y);
    // The side planes: left and right in view x and z, top and bottom in view y and z.
    vec2 left = vec2(-3.0 * effector.projection_x, 2.0 - x);
    vec2 right = vec2(3.0 * effector.projection_x, x - 3.0);
    vec2 top = vec2(3.0 * effector.projection_y, 2.0 - y);
    vec2 bottom = vec2(-3.0 * effector.projection_y, y - 3.0);
    left *= inversesqrt(dot(left, left));
    right *= inversesqrt(dot(right, right));
    top *= inversesqrt(dot(top, top));
    bottom *= inversesqrt(dot(bottom, bottom));
    const float slice_start = 0.1 * (effector.depth * float(cell.z)) + effector.start;
    const float slice_end = effector.slice + slice_start;
    uint entry = ((cell.z * 6u + cell.y) * 6u + cell.x) * GridEntries;
    const uint last = entry + GridEntries - 1u;
    for (uint s = 0u; s < effector.count; s++) {
        const uvec4 sphere = effector.spheres[2u * s];
        const vec3 c = (effector.view * vec4(uintBitsToFloat(sphere.xyz), 1.0)).xyz;
        const float sides = min(min(dot(bottom, c.yz), min(dot(left, c.xz), dot(right, c.xz))),
                                dot(top, c.yz));
        const float inside = min(min(slice_end + c.z, sides), -slice_start - c.z);
        if (inside >= -unpackHalf2x16(sphere.w).x) {
            cells.entries[entry] = s;
            entry = min(entry + 1u, last);
        }
    }
    cells.entries[entry] = 0xffffffffu;
}
